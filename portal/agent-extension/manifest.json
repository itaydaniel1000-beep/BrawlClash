{
  "manifest_version": 3,
  "name": "Portal AI Agent Connector",
  "version": "1.1.0",
  "description": "מחבר את הסוכן שבפורטל אל הדפדפן: זיהוי טאבים + הרצת משימות אוטומטיות (Gemini) על הטאב הנבחר.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://itaydaniel1000-beep.github.io/*",
    "<all_urls>"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://itaydaniel1000-beep.github.io/BrawlClash/portal/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
